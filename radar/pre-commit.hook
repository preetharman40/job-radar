#!/usr/bin/env bash
# Radar pre-commit hook. Install with:
#
#   ln -sf ../../radar/pre-commit.hook .git/hooks/pre-commit
#
# (a symlink, so edits here take effect without reinstalling)
#
# Why: three defects shipped on 2026-10-27 that a check which simply RAN the
# thing would have caught in seconds - a half-written cronwrap.sh exec'd by a
# cron lane, a string/int comparison that stored a failure tail on every run,
# and an over-anchored regex that silently extracted metrics from one lane and
# not the other.
#
# --quick by default: tiers 1-3 are static, service and data checks and finish
# in about a second, so they can run on every commit without being resented.
# The tier-4 smoke tests use the network and take a couple of minutes - run
# them by hand, or set RADAR_FULL_SELFTEST=1 to include them here.
#
# Bypass once with:  git commit --no-verify
set -uo pipefail
R="$(git rev-parse --show-toplevel)/radar"
[ -x "$R/selftest.py" ] || exit 0

args=(--quick)
[ "${RADAR_FULL_SELFTEST:-0}" = "1" ] && args=()

echo "pre-commit: running radar selftest ${args[*]}"
if ! "$R/selftest.py" "${args[@]}"; then
  echo
  echo "pre-commit: SELFTEST FAILED - commit refused."
  echo "  Fix the failures above, or bypass with: git commit --no-verify"
  exit 1
fi
